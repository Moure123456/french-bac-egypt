  {
   "file": "song_51.mp3",
   "title_fr": "L'alphabet",
   "title_ar": "أغنية الحروف",
   "tts": true,
   "kids": true,
   "lines": [
    {
     "fr": "A, B, C, D, E, F, G",
     "ar": "آ، بي، سي، دي، إي، إف، جي"
    },
    {
     "fr": "H, I, J, K, L, M, N",
     "ar": "آش، إي، جي، كا، إل، إم، إن"
    },
    {
     "fr": "O, P, Q, R, S, T",
     "ar": "أو، بي، كي، إير، إس، تي"
    },
    {
     "fr": "U, V, W, X, Y, Z",
     "ar": "يو، في، دوبل في، إكس، إيغريك، زد"
    },
    {
     "fr": "Voilà l'alphabet !",
     "ar": "هذه هي الأبجدية!"
    },
    {
     "fr": "Chantons-le ensemble !",
     "ar": "لنغنّها معًا!"
    }
   ]
  },
  {
   "file": "song_52.mp3",
   "title_fr": "Les nombres de 1 à 10",
   "title_ar": "الأرقام من 1 إلى 10",
   "tts": true,
   "kids": true,
   "lines": [
    {
     "fr": "Un, deux, trois, je compte avec toi",
     "ar": "واحد، اثنان، ثلاثة، أعدّ معك"
    },
    {
     "fr": "Quatre, cinq, six, c'est facile, tu vois",
     "ar": "أربعة، خمسة، ستة، الأمر سهل كما ترى"
    },
    {
     "fr": "Sept, huit, neuf, je lève mon doigt",
     "ar": "سبعة، ثمانية، تسعة، أرفع إصبعي"
    },
    {
     "fr": "Dix ! J'ai fini, bravo pour moi !",
     "ar": "عشرة! انتهيت، أحسنت لنفسي!"
    },
    {
     "fr": "Un, deux, trois, quatre, cinq",
     "ar": "واحد، اثنان، ثلاثة، أربعة، خمسة"
    },
    {
     "fr": "Six, sept, huit, neuf, dix !",
     "ar": "ستة، سبعة، ثمانية، تسعة، عشرة!"
    }
   ]
  },
  {
   "file": "song_53.mp3",
   "title_fr": "Les nombres de 11 à 20",
   "title_ar": "الأرقام من 11 إلى 20",
   "tts": true,
   "kids": true,
   "lines": [
    {
     "fr": "Onze, douze, treize, quatorze",
     "ar": "أحد عشر، اثنا عشر، ثلاثة عشر، أربعة عشر"
    },
    {
     "fr": "Quinze, seize, c'est un jeu",
     "ar": "خمسة عشر، ستة عشر، إنها لعبة"
    },
    {
     "fr": "Dix-sept, dix-huit, dix-neuf",
     "ar": "سبعة عشر، ثمانية عشر، تسعة عشر"
    },
    {
     "fr": "Vingt ! Nous comptons très bien",
     "ar": "عشرون! نحن نعدّ جيدًا"
    },
    {
     "fr": "Compte avec moi jusqu'à vingt",
     "ar": "عدّ معي حتى العشرين"
    },
    {
     "fr": "Hourra, nous savons compter !",
     "ar": "هيه، نحن نعرف العدّ!"
    }
   ]
  },
  {
